# Copy to .env (gitignored) in this directory to enable real SSO sign-in
# with `docker compose up`. Without any provider's credentials set, only
# /auth/dev-login is available — see MAPPING.md ("Known gaps: Auth") and
# src/auth/oidcProviders.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the client (browser-facing) origin, not this server's own — see
# APP_BASE_URL below for why: the OAuth callback route ends with a
# redirect to '/', which needs to resolve against the client. Register
# this exact URL as an authorized redirect URI in the provider's console.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Comma-separated hosted domains, beyond usdigitalresponse.org/usdrvolunteers.org,
# whose Google sign-ins get a full user account. Use this for a
# government partner's own domain during local dev/demo if they use
# Google — never commit real partner domains here, only in your local
# .env.
GOOGLE_ALLOWED_DOMAINS=

# Microsoft Entra ID (Azure AD) app registration, for an agency whose
# staff sign in with Microsoft instead of Google — all three must be set
# for Microsoft sign-in to be enabled. MICROSOFT_ALLOWED_DOMAINS is that
# agency's own hosted domain(s), comma-separated; unlike Google's list,
# it has no built-in default.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5173/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAINS=

# Comma-separated individual email addresses allowed to request a
# magic-link sign-in (POST /auth/magic-link/request) — see MAPPING.md
# "Magic-link sign-in for external users". Keep real external
# vendor/contact emails out of the repo.
EXTERNAL_EMAIL_WHITELIST=

# Used to build the magic-link URL emailed to a requester. Must be where
# the *browser* should land — the client dev server (which proxies /auth
# to the API server), not the API server itself, since the verify route
# ends with a redirect to '/'.
APP_BASE_URL=http://localhost:5173

# Verified SES sender identity used to actually email magic links (see
# MAPPING.md "Magic-link sign-in for external users"). Without this set,
# the link is just logged to the server console instead — fine for local
# dev, not for anyone who isn't reading server logs. AWS credentials/
# region are resolved the normal AWS SDK way, not via a var here.
SES_SENDER_EMAIL=
