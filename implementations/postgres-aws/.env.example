# Copy to .env (gitignored) in this directory to enable real SSO sign-in
# with `docker compose up`. Without any provider's credentials set, only
# /auth/demo-login is available — see MAPPING.md ("Known gaps: Auth") and
# src/auth/oidcProviders.ts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the client (browser-facing) origin, not this server's own: the
# OAuth callback route ends with a redirect to '/', which needs to resolve
# against the client. Register this exact URL as an authorized redirect URI
# in the provider's console.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Comma-separated hosted domains, beyond usdigitalresponse.org/usdrvolunteers.org,
# whose Google sign-ins get a full user account. Use this for a
# government partner's own domain during local dev/demo if they use
# Google — never commit real partner domains here, only in your local
# .env.
GOOGLE_ALLOWED_DOMAINS=

# Microsoft Entra ID (Azure AD) app registration, for an agency whose
# staff sign in with Microsoft instead of Google — all three must be set
# for Microsoft sign-in to be enabled. MICROSOFT_ALLOWED_DOMAINS is that
# agency's own hosted domain(s), comma-separated; unlike Google's list,
# it has no built-in default.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5173/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAINS=

# Comma-separated individual email addresses allowed to request an
# emailed sign-in code (POST /auth/code/request) — see MAPPING.md
# "Emailed-code sign-in for external users". Keep real external
# vendor/contact emails out of the repo.
EXTERNAL_EMAIL_WHITELIST=

# Private directory for uploaded invoice files. A file is kept with its live
# request and deleted on discard, expiry of an unconfirmed import, or when the
# request is withdrawn or deleted; keep this directory out of backups. It
# defaults to a folder under the OS temp directory, which a reboot may clear.
DOCUMENT_STORE_DIR=

# How PDF invoices are read (server/src/imports/extractors/). Default:
# pdf-text-layer, in-process. Methods outside the processing boundary are
# refused when NODE_ENV=production.
INVOICE_EXTRACTOR=

# Uploaded PDFs are read in a child process with memory and time limits.
# "inline" reads them in the server process instead (tests); leave unset.
INVOICE_EXTRACTION_ISOLATION=
# That process's Node heap in MB (default 512). Recognition's own memory is
# outside it; docker-compose.prod.yml bounds the container.
INVOICE_EXTRACTION_MEMORY_MB=

# The client's public origin. Sign-in emails carry a code, not a link, so
# the server doesn't read this at the moment.
APP_BASE_URL=http://localhost:5173

# Verified SES sender identity used to actually email sign-in codes (see
# MAPPING.md "Emailed-code sign-in for external users"). Without this set,
# the code is just logged to the server console instead — fine for local
# dev, not for anyone who isn't reading server logs. AWS credentials/
# region are resolved the normal AWS SDK way, not via a var here.
SES_SENDER_EMAIL=

# Driving distances for the mileage distance billing rule. "aws" uses Amazon
# Location (Geocode and CalculateRoutes, billed per request) with the normal
# AWS SDK credentials and AWS_REGION; blank looks nothing up, and reviewers
# check trips with a directions link. Lookups happen only on submission with
# the rule on and are cached by address pair; each new trip uses up to 3
# calls. The server logs a warning once a calendar month's calls pass the
# warning level; an optional limit stops lookups for the rest of the month.
ROUTE_CHECK_PROVIDER=
ROUTE_CHECK_MONTHLY_CALL_WARNING=1000
ROUTE_CHECK_MONTHLY_CALL_LIMIT=
ROUTE_CHECK_COUNTRY=USA
