  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": {
        "color": "#072a4a4d",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "1px"
      },
      "$extensions": {
        "figma": "Elevation 1",
        "css": "--elevation-1"
      }
    },
    "2": {
      "$type": "shadow",
      "$value": {
        "color": "#072a4a4d",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "6px",
        "spread": "1px"
      },
      "$extensions": {
        "figma": "Elevation 2",
        "css": "--elevation-2"
