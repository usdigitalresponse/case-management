{
  "name": "case-management-postgres-aws-server",
  "private": true,
  "version": "0.1.0",
  "description": "Express/Drizzle/Postgres API for the postgres-aws case-management implementation.",
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/app.js",
    "dev": "tsx watch src/app.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-schema-mapping": "tsx scripts/verify-schema-mapping.ts",
    "demo-invoices": "tsx scripts/demo-invoices.ts",
    "generate-sample-pdfs": "tsx scripts/generate-sample-pdfs.ts",
    "extraction-accuracy": "tsx scripts/extraction-accuracy.ts",
    "extract-invoice": "tsx scripts/extract-invoice.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1145.0",
    "@faker-js/faker": "^10.6.0",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.19.2",
    "passport": "^0.7.0",
    "passport-openidconnect": "^0.1.2",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.1",
    "@types/passport": "^1.0.16",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "js-yaml": "^4.1.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
