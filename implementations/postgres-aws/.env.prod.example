# Copy to .env.prod (gitignored) for docker-compose.prod.yml. Generate
# each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=

# Hosted: the instance's sslip.io hostname, e.g. 203-0-113-10.sslip.io,
# and APP_BASE_URL=https://<that hostname>. Local test: leave both as is.
SITE_ADDRESS=:80
APP_BASE_URL=http://localhost

# Passwordless sign-in for anyone who can reach the site, as the synthetic
# staff account and as a seeded demo vendor (external partner). Only for
# synthetic-data demos.
DEMO_LOGIN_ENABLED=true
EXTERNAL_DEMO_LOGIN_ENABLED=true

# Optional: comma-separated external emails allowed to request a sign-in
# link. Without SES configured, the link is written to the server log.
EXTERNAL_EMAIL_WHITELIST=

# Optional memory limits (defaults fit the 1 GB demo instance with its 2 GB
# swap file). The server container, including the processes that read
# uploaded PDFs; a scan peaks around 500–700 MB. Raise both on a bigger host.
# SERVER_MEMORY_LIMIT=700m
# SERVER_MEMORY_SWAP_LIMIT=1700m
# Node heaps, kept below the container limit: the server's, and each PDF
# reader's (which only stops runaway scripts; recognition lives outside it).
# SERVER_HEAP_MB=256
# INVOICE_EXTRACTION_MEMORY_MB=512
