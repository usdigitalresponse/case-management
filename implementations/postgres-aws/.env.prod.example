# Copy to .env.prod (gitignored) for docker-compose.prod.yml. Generate
# each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=

# Hosted: the instance's sslip.io hostname, e.g. 203-0-113-10.sslip.io,
# and APP_BASE_URL=https://<that hostname>. Local test: leave both as is.
SITE_ADDRESS=:80
APP_BASE_URL=http://localhost

# Optional: comma-separated external emails allowed to request a sign-in
# link. Without SES configured, the link is written to the server log.
EXTERNAL_EMAIL_WHITELIST=
